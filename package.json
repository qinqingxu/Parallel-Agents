{
  "name": "parallel-agents",
  "version": "0.1.7",
  "description": "Run multiple CLI coding agents side by side in one window.",
  "main": "out/main/index.js",
  "author": {
    "name": "jelllove",
    "email": "jelllove@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": "^24.17.0",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "node --test --test-concurrency=4 --import ./tests/helpers/isolated-git.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mjs",
    "test:coverage": "node --test --test-concurrency=4 --import ./tests/helpers/isolated-git.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage tests/*.test.mjs",
    "pretest:ci": "node scripts/ci-report.mjs --prepare",
    "test:ci": "node scripts/test-ci.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:maintenance-loop": "node --test tests/e2e/maintenance-loop.e2e.mjs",
    "test:security": "node --test --import ./tests/helpers/isolated-git.mjs tests/security/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:packaged": "node scripts/smoke.mjs --packaged",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "ci:prepare": "node scripts/ci-report.mjs --prepare",
    "ci:report": "node scripts/ci-report.mjs",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "agent:serve": "node scripts/mcp-server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "maintenance:check": "node scripts/maintenance.mjs",
    "maintenance:apply": "node scripts/maintenance.mjs --apply",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:docs",
    "validate": "npm run check && npm run build",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty",
    "pack": "npm run build && npm run test:smoke && electron-builder --dir --publish never && npm run test:packaged",
    "dist": "npm run build && npm run test:smoke && electron-builder --publish never && npm run test:packaged",
    "release": "npm run pack && node scripts/promote-latest.cjs",
    "build:icons": "node scripts/build-icons.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "material-icon-theme": "^5.34.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "1.2.0-beta.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.jelllove.parallelagents",
    "productName": "Parallel Agents",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/icon-96.png",
        "to": "icon-96.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app-icon.ico",
      "signAndEditExecutable": false
    }
  }
}
